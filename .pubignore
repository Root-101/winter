# What `dart pub publish` leaves out. With this file, pub no longer reads .gitignore here,
# so its entries are repeated.

# From .gitignore
.dart_tool/
.idea/
.fvm/
pubspec.lock
*.iml
CLAUDE.md
brag-output/

# Tooling of the repository, not of the package
.fvmrc
.dockerignore
.github/
slang.yaml
benchmark/
coverage/
doc/api/
todo.md
ROADMAP.md

# Generated by the examples when they run
example/**/.dart_tool/
example/**/pubspec.lock
example/**/uploads/
example/openapi/openapi.json
